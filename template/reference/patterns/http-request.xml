                    </munit-tools:with-attributes>
                    <munit-tools:then-return>
                        <munit-tools:payload value="#[readUrl('classpath://samples/customer/found.crm.json','application/json')]"/>
                        <munit-tools:attributes value="#[{statusCode: 200}]"/>
                    </munit-tools:then-return>
                </munit-tools:mock-when>
            </munit:behavior>
            <munit:execution>
                <munit:set-event><munit:variables>
                    <munit:variable key="customerId" value="C001"/>
