<?xml version="1.0" encoding="UTF-8"?>
<!-- 写経元: 受け口。listener + apikit:router と、APIkit が振り分ける flow。
     エラーハンドラは書かない (global.xml の defaultErrorHandler-ref が効く)。 -->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd">

    <!-- RAML の baseUri (http://localhost:8081/api) に合わせて /api/* で受ける。
         応答のステータスとヘッダは vars から取る (apikit:config の httpStatusVarName / outboundHeadersMapName と同じ名前)。
         attributes.requestPath は "/api/..." のようにベースパス込みで返る。 -->
    <flow name="profile-api-main" doc:name="受け口 (HTTP リスナー + APIkit ルーター)">
        <http:listener config-ref="profile-api-httpListenerConfig" path="/api/*" doc:name="HTTP リクエスト受信">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="profile-api-config" doc:name="APIkit ルーター"/>
    </flow>

    <!-- APIkit の flow 名は <method>:\<path>:<mediaType>:<config> の生成名のまま。
         uriParams を vars に立てて実処理へ flow-ref するだけにする。実処理は HTTP を知らない。 -->
    <flow name="put:\customers\(customerId)\profile:application\json:profile-api-config"
          doc:name="profile 更新 (受け口)">
        <set-variable variableName="customerId" value="#[attributes.uriParams.customerId]" doc:name="customerId を立てる"/>
        <flow-ref name="change-profile" doc:name="change-profile を呼ぶ"/>
    </flow>

    <!-- flow 名の作られ方。**1 文字でも違うと APIkit が「flow が無い」と言って 404 になる。**
         規則: <method>:\<path>[:<mediaType>]:<apikit:config の name>
           - パスの / は \ になる。URI パラメータは (名前) で囲む
           - **本文を持つメソッド (POST / PUT / PATCH) だけ :<mediaType> が入る。**
             GET / DELETE には入らない。ここが最も間違えやすい
           - mediaType の / も \ になる (application\json)
         例 (RAML の baseUri が http://localhost:8081/api、listener が /api/* のとき):

           GET    /customers/{customerId}          → get:\customers\(customerId):profile-api-config
           GET    /customers                       → get:\customers:profile-api-config
           POST   /customers                       → post:\customers:application\json:profile-api-config
           DELETE /customers/{customerId}          → delete:\customers\(customerId):profile-api-config

         受け口の中身はどれも同じ: uriParams / queryParams を vars に立てて実処理へ flow-ref するだけ。
         実処理の flow は HTTP を知らないので MUnit から直接 flow-ref できる。

         **下の 3 つは flow 名の例で、flow-ref の先は自分で書く。** このファイルだけを丸写しすると
         参照先が無い状態になる。写経元がある先: change-profile → resource-impl.xml (実測済み)、
         fetch-customer → patterns/http-request.xml、create-customer → patterns/db-operations.xml。
         list-customers に写経元は無い (一覧は db:select + 変換だけなので resource-impl.xml から起こす)。 -->
    <flow name="get:\customers\(customerId):profile-api-config" doc:name="customer 取得 (受け口)">
        <set-variable variableName="customerId" value="#[attributes.uriParams.customerId]" doc:name="customerId を立てる"/>
        <flow-ref name="fetch-customer" doc:name="fetch-customer を呼ぶ"/>
    </flow>

    <flow name="get:\customers:profile-api-config" doc:name="customer 一覧 (受け口)">
        <!-- クエリは queryParams。RAML で既定値を書いていても、書いていなければ null になるので default を置く。 -->
        <set-variable variableName="status" value="#[attributes.queryParams.status default 'active']" doc:name="status を立てる"/>
        <flow-ref name="list-customers" doc:name="list-customers を呼ぶ"/>
    </flow>

    <flow name="post:\customers:application\json:profile-api-config" doc:name="customer 登録 (受け口)">
        <!-- 201 のように 200 以外を返すときは、実処理側ではなくここで vars.httpStatus を立ててもよい。
             どちらで立てるかはリポジトリ内で揃える (CLAUDE.md の命名規約に従う)。 -->
        <flow-ref name="create-customer" doc:name="create-customer を呼ぶ"/>
    </flow>

</mule>
