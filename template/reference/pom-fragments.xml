<!-- pom.xml に足す断片。api/ (RAML) と samples/ (受け入れ条件) をクラスパスに乗せる。
     api/ が無いと apikit:config の api="api/customer-api.raml" が "Raml not found" になる。
     samples/ が無いと MUnit の readUrl("classpath://samples/...") が読めない。 -->
<build>
    <resources>
        <resource>
            <directory>src/main/resources</directory>
        </resource>
        <resource>
            <directory>api</directory>
            <targetPath>api</targetPath>
        </resource>
    </resources>
    <testResources>
        <testResource><directory>src/test/resources</directory></testResource>
        <testResource>
            <directory>samples</directory>
            <targetPath>samples</targetPath>
        </testResource>
    </testResources>
</build>

<!-- ================================================================
     JDBC ドライバ。DB コネクタを使うなら **2 箇所** に書く。片方だけでは動かない。

       (1) <dependencies> の <dependency>  … Maven に jar を取ってこさせる。version を書く
       (2) mule-maven-plugin の <sharedLibraries> … アプリから見えるようにする。**version は書かない**

     (2) を忘れると、jar は取れているのに実行時に見つからない。JDBC ドライバは mule-plugin ではない
     素の jar なので、共有ライブラリとして宣言しないと db コネクタ (generic-connection など) から
     見えないため。**MUnit は db:* を mock するので緑のまま通り、配備して初めて分かる。**
     (finance-api の pom.xml で実際にこの形で通っている。T-009 で踏んで直した箇所。)

     **座標は推測しない** (「GAV は推測しない」規則)。使う製品のものを Maven Central で確かめる。
     製品ごとに artifactId も version 体系も違う。Oracle は ojdbc 本体のほかに ucp / ons / oraclepki
     などの随伴 artifact が要ることがある (随伴ぶんは dependency にだけ書き、sharedLibrary は本体だけでよい)。
     ================================================================ -->
